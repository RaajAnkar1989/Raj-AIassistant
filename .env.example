# ElevenLabs — API key if agent has authentication enabled
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Optional — override default agent (Raaj-AI-Assistant-New)
# VITE_ELEVENLABS_AGENT_ID=agent_6401ks3bv7wafb5sr6dgwqstsa98

# Set to true only if you want the app to override the ElevenLabs dashboard system prompt
# VITE_RAJ_USE_PROMPT_OVERRIDE=false

# ── Local dev brain (Ollama — no API keys or billing) ──
# Run: ollama serve
# For phone/Netlify from your Mac:
#   npm run tunnel:ollama          # keep open — exposes Ollama to internet
#   npm run sync:ollama-netlify    # pushes tunnel URL to Netlify + deploys
# VITE_OLLAMA_MODEL=llama3.1:8b

# ── Netlify / production (required for hosted brain on phone) ──
# One-command sync from local (encrypted on Netlify):
#   netlify login && npm run sync:netlify-env
#
# Or set manually in Netlify → Site settings → Environment variables.
# Get unified key: curl -s http://127.0.0.1:3001/api/settings/api-key
# VITE_FREELLMAPI_URL=https://your-brain-server.up.railway.app/v1
# VITE_FREELLMAPI_KEY=freellmapi-your-unified-key

# Simpler fallback — Gemini direct (auto-pulled from local FreeLLMAPI by sync script)
# VITE_GEMINI_API_KEY=AIza...

# Optional — legacy OpenAI (not used when ElevenLabs conversation is active)
VITE_OPENAI_API_KEY=

# Google OAuth Client ID — Gmail + Calendar integrations
VITE_GOOGLE_CLIENT_ID=
