{
  "name": "ai-voice-assistant-pwa",
  "version": "1.0.0",
  "description": "Raj — Jarvis-style voice assistant for iPhone. Opens real apps, speaks calendar and weather.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:app": "vite",
    "setup:local": "node scripts/ensure-local-services.mjs",
